# Hosted production runs its own model service. A client may replace the model
# boundary by changing CVI_LLM_PROVIDER / CVI_OLLAMA_BASE_URL and model names.
CVI_LLM_PROVIDER=ollama
CVI_LLM_STRUCTURED_METHOD=json_schema
CVI_EVALUATOR_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# Compose sets the service name. Override only when pointing at a client LLM.
# On Docker Desktop, an already-installed host Ollama daemon can be reached at
# http://host.docker.internal:11434 (bind host Ollama to 0.0.0.0:11434 first).
CVI_OLLAMA_BASE_URL=http://localhost:11434
# Set when models are already present in an external Ollama daemon; the
# bootstrap then skips /api/pull and only prepares local speech assets.
# CVI_SKIP_OLLAMA_PULL=1

# Optional cloud adapters. Leave unset for the default self-hosted deployment.
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b
# Keep first-question latency predictable. Raise only for stable paid tiers.
CVI_LLM_MAX_RETRIES=0
CVI_LLM_REQUEST_TIMEOUT=12

# Per-purpose sampling. Evidence/extraction/evaluator paths stay at 0;
# proposal generation and short vocal reflections use a small range for
# natural variety. Defaults are 0 / 0.3 / 0.4 when unset.
# CVI_LLM_TEMPERATURE=0
# CVI_PROPOSAL_TEMPERATURE=0.3
# CVI_ENGAGEMENT_TEMPERATURE=0.4

# Voice delivery profile. English with an Indian cadence is the default.
# Hosted production uses the self-hosted speech service. Clients may replace
# STT/TTS with their own endpoints and credentials via the provider variables.
CVI_VOICE_LANGUAGE=en-IN
CVI_VOICE_SOFTNESS=gentle
CVI_VOICE_RATE=1.0
CVI_VOICE_PITCH=1.0
CVI_VOICE_VOLUME=1.0
CVI_VOICE_STT_PROVIDER=local
CVI_VOICE_STT_FALLBACKS=local,typed
CVI_VOICE_TTS_PROVIDER=local
CVI_VOICE_TTS_FALLBACKS=local,browser

# Optional cloud speech adapters. Not used by the default deployment.
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=playai-tts
# GROQ_TTS_VOICE=Arista

# Optional enterprise self-hosted STT/TTS adapters.
# Each endpoint receives multipart audio (STT) or JSON text (TTS).
# CVI_LOCAL_STT_URL=http://localhost:9000/transcribe
# CVI_LOCAL_TTS_URL=http://localhost:9001/synthesize
# CVI_LOCAL_STT_API_KEY=replace_if_needed
# CVI_LOCAL_TTS_API_KEY=replace_if_needed

# Self-hosted speech stack. Compose overrides these URLs with service names.
# Production: docker compose -f compose.yaml -f compose.prod.yaml up -d
# Testing:    docker compose -f compose.yaml -f compose.local.yaml --profile offline up -d
CVI_LOCAL_MODEL_DIR=./data/models
CVI_SPEECH_URL=http://localhost:9000
# Optional explicit streaming URL; derived from CVI_SPEECH_URL when unset.
# CVI_SPEECH_STREAM_URL=ws://localhost:9000/stream
CVI_LOCAL_STT_MODEL=small

# Server-side VAD runs in the speech service, not the participant's browser.
# silero is the default neural detector; energy is a dependency-free fallback.
CVI_SPEECH_VAD_PROVIDER=silero
CVI_SPEECH_VAD_THRESHOLD=0.5
CVI_SPEECH_MIN_SPEECH_MS=200
CVI_SPEECH_END_SILENCE_MS=700
CVI_SPEECH_MAX_SEGMENT_MS=30000
CVI_SPEECH_MIN_SEGMENT_MS=350
CVI_SPEECH_COOLDOWN_MS=200
CVI_SPEECH_TAIL_SILENCE_MS=150
# Optional override; when unset, LOCAL_LLM_MODEL is pulled.
# CVI_LOCAL_PULL_MODELS=llama3.2:3b,llama3.2:1b
CVI_LOCAL_TTS_MODEL=./data/models/tts/en_US-amy-medium.onnx
CVI_LOCAL_TTS_CONFIG=./data/models/tts/en_US-amy-medium.onnx.json
CVI_LOCAL_TTS_MODEL_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx?download=1
CVI_LOCAL_TTS_CONFIG_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx.json?download=1

# Optional live Sarvam realtime STT bridge (legacy websocket path).
# SARVAM_API_KEY=your_sarvam_api_key_here

# Researcher dashboard access. The legacy account remains available:
# username "researcher", password = RESEARCHER_ACCESS_CODE, role = admin.
RESEARCHER_ACCESS_CODE=replace_with_a_long_random_value

# Optional named researcher accounts. JSON maps username -> password string
# or {password, role, tenant_id}. role is "researcher" (default) or "admin".
# Researchers only see sessions they created; admins see every session in the
# tenant. Legacy sessions with no owner remain visible to all authenticated users.
# CVI_RESEARCHER_ACCOUNTS='{"alice":{"password":"alice-secret","role":"researcher"},"bob":"bob-secret"}'
# Session creation fails closed unless an auth code/account is configured.
# Only set this for a local, non-hosted process that deliberately has no auth.
# CVI_ALLOW_UNAUTHENTICATED_LOCAL=1

# Durable research-memory backend. PostgreSQL is the hosted production
# implementation. SQLite is for offline tests only.
# compose.prod.yaml overrides CVI_DATABASE_URL per service; the values below
# are for direct host runs.
CVI_PERSISTENCE_BACKEND=postgresql
CVI_DATABASE_URL=postgresql://cvi:change-me@db:5432/cvi_research
# Required by the db service in compose.prod.yaml; use the same credentials.
POSTGRES_DB=cvi_research
POSTGRES_USER=cvi
POSTGRES_PASSWORD=change-me

# Hosted PostgreSQL uses three distinct credentials. Generate long random
# passwords and URL-encode them inside each DSN. db-bootstrap creates the
# runtime/backup roles; migrations keep the DDL-capable owner credential.
CVI_MIGRATION_DATABASE_URL=postgresql://cvi:change-me@db:5432/cvi_research
CVI_RUNTIME_DATABASE_URL=postgresql://cvi_runtime:change-me-runtime@db:5432/cvi_research
CVI_BACKUP_DATABASE_URL=postgresql://cvi_backup:change-me-backup@db:5432/cvi_research
CVI_RUNTIME_DB_USER=cvi_runtime
CVI_RUNTIME_DB_PASSWORD=change-me-runtime
CVI_BACKUP_DB_USER=cvi_backup
CVI_BACKUP_DB_PASSWORD=change-me-backup
# Optional when the migration DSN user is not the role that owns new tables.
# CVI_MIGRATION_DB_USER=cvi

# SQLite path used only when CVI_PERSISTENCE_BACKEND=sqlite for tests.
CVI_READ_MODEL_DB=./data/research_read_model.sqlite3

# Durable background worker. Hosted production runs the separate `worker`
# service and sets CVI_WORKER_ENABLED=1 on both API and worker. Multiple API and
# worker replicas are safe: per-session leases live in the durable store.
# Offline tests keep the in-process executor path (CVI_WORKER_ENABLED=0).
CVI_WORKER_ENABLED=1
# Optional tuning. Defaults: batch 4, poll 0.25s, retry 5s, stale 300s, lease 300s.
# Set a distinct ID per worker replica, or leave unset for an auto-generated ID.
# CVI_WORKER_ID=cvi-worker-1
# CVI_WORKER_BATCH_SIZE=4
# CVI_WORKER_POLL_INTERVAL_SECONDS=0.25
# CVI_WORKER_RETRY_DELAY_SECONDS=5
# CVI_WORKER_STALE_TIMEOUT_SECONDS=300
# A configured CVI_WORKER_ID is a readable label; each process adds a unique
# suffix. Heartbeats keep long jobs from being recovered as stale.
# CVI_WORKER_HEARTBEAT_SECONDS=30
# CVI_SESSION_LEASE_TTL_SECONDS=300

# Structured logging. JSON is the default and is recommended for containers;
# use "text" for human-readable local output.
CVI_LOG_FORMAT=json
CVI_LOG_LEVEL=info

# Deployment tenant ID. Every durable record is stamped with this value and
# every researcher query is filtered by it. Use a distinct value per research
# team or customer. Allowed: letters, digits, _, ., :, - (max 64 chars).
CVI_TENANT_ID=default

# Local abuse limits for participant traffic. These are per API process; use a
# reverse proxy for shared cluster-wide quotas. Payload and stream caps are
# code constants in agent/limits.py and are intentionally not client-tunable.
# CVI_RATE_LIMIT_ENABLED=1
# CVI_RATE_LIMIT_WINDOW_SECONDS=60
# CVI_RATE_LIMIT_SESSION_PER_MINUTE=300
# CVI_RATE_LIMIT_IP_PER_MINUTE=1000
# CVI_RATE_LIMIT_WEBSOCKET_PER_MINUTE=30

