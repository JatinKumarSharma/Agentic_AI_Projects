# Select the LLM provider
LLM_PROVIDER=groq

# Groq configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini configuration
GOOGLE_API_KEY=your_google_api_key
GOOGLE_MODEL=gemini-2.5-flash

# Ollama configuration
OLLAMA_MODEL=llama3.2:3b

# Financial data provider
FMP_API_KEY=your_fmp_api_key

# Optional evidence sources
# SEC EDGAR needs no key. Set a descriptive user agent with contact information.
SEC_USER_AGENT=FinancialResearchAssistant/1.2 (research prototype; contact@example.com)

# FRED macro indicators
FRED_API_KEY=your_fred_api_key

# Web search: leave WEB_SEARCH_PROVIDER unset for auto-detection and failover.
# If set, that provider is tried first; failed providers fall back to the next
# configured key in this order: tavily, brave, serper.
# WEB_SEARCH_PROVIDER=tavily|brave|serper
TAVILY_API_KEY=your_tavily_api_key
BRAVE_API_KEY=your_brave_api_key
SERPER_API_KEY=your_serper_api_key

# Optional strict allowlist override (comma-separated domains).
WEB_SEARCH_ALLOWED_DOMAINS=sec.gov,reuters.com,bloomberg.com,ft.com,wsj.com,cnbc.com,marketwatch.com,nasdaq.com,finance.yahoo.com,investing.com,morningstar.com
